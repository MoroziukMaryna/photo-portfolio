---
import { sanityClient } from 'sanity:client';

const projects = await sanityClient.fetch(`
  *[_type == "project"] | order(_createdAt desc) {
    _id,
    titleUa,
    titleEn,
    category,
    "slug": slug.current,
    "mainImageUrl": mainImage.asset->url,
    "coverUrl": coverImage.asset->url,
    "galleryUrls": gallery[].asset->url
  }
`);

function getHighResUrl(url: string | undefined, width = 1600) {
  if (!url) return '';
  const separator = url.includes('?') ? '&' : '?';
  return `${url}${separator}w=${width}&q=90&auto=format`;
}

const categories = [
  { id: 'all', ua: 'Усі', en: 'All' },
  { id: 'portrait', ua: 'Портрет', en: 'Portrait' },
  { id: 'fashion', ua: 'Фешн', en: 'Fashion' },
  { id: 'studio', ua: 'Студійна', en: 'Studio' },
  { id: 'lovestory', ua: 'Love Story', en: 'Love Story' },
  { id: 'wedding', ua: 'Весільна', en: 'Wedding' },
];
---

<html lang="uk" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Галерея робіт | Portfolio</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#232220] text-[#f5f2eb] min-h-screen antialiased pt-32">

    <!-- ШАПКА -->
    <header class="site-header fixed top-0 left-0 right-0 z-50 pt-6 pb-12">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <a href="/" class="header-logo text-xl tracking-[0.25em] uppercase font-light">
          PHOTOGRAPHER
        </a>

        <!-- ДЕСКТОПНЕ МЕНЮ -->
        <nav class="hidden md:flex items-center gap-10 text-sm uppercase tracking-[0.2em] font-light">
          <a href="/gallery" data-i18n-ua="Галерея" data-i18n-en="Gallery" class="site-nav-link active text-white border-b border-white pb-0.5 font-normal">Галерея</a>
          <a href="/price" data-i18n-ua="Прайс" data-i18n-en="Price" class="site-nav-link text-stone-300 hover:text-white transition">Прайс</a>
          <a href="/about" data-i18n-ua="Про мене" data-i18n-en="About" class="site-nav-link text-stone-300 hover:text-white transition">Про мене</a>
        </nav>

        <!-- ДЕСКТОПНІ ПЕРЕМИКАЧІ -->
        <div class="hidden md:flex items-center gap-3 text-sm font-light tracking-wider">
          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button class="lang-ua px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-active bg-stone-200 text-stone-900 shadow">UA</button>
            <button class="lang-en px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-inactive text-stone-400 hover:text-white">EN</button>
          </div>

          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button class="theme-toggle px-2.5 py-1 rounded-full text-xs cursor-pointer text-stone-300 hover:text-white flex items-center justify-center" title="Toggle Theme">
              <svg class="theme-icon-moon w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M21.75 15.002A9.718 9.718 0 0112 21.75c-5.385 0-9.75-4.365-9.75-9.75 0-4.137 2.57-7.676 6.22-9.11a.75.75 0 01.916.92 7.502 7.502 0 009.244 9.244.75.75 0 01.92.916z"/>
              </svg>
              <svg class="theme-icon-sun w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
                <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.061-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.166 5.106a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.061-1.06l-1.59-1.591z"/>
              </svg>
            </button>
          </div>
        </div>

        <button id="mobile-menu-btn" class="md:hidden text-2xl p-1 focus:outline-none" aria-label="Toggle Menu">☰</button>
      </div>

      <!-- МОБІЛЬНЕ МЕНЮ -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#232220]/95 backdrop-blur-lg px-6 py-6 flex-col items-center gap-5 text-center mt-2 border-b border-stone-700/50">
        <a href="/gallery" data-i18n-ua="Галерея" data-i18n-en="Gallery" class="text-base uppercase tracking-[0.2em] text-white font-bold py-1">Галерея</a>
        <a href="/price" data-i18n-ua="Прайс" data-i18n-en="Price" class="text-base uppercase tracking-[0.2em] text-stone-200 py-1">Прайс</a>
        <a href="/about" data-i18n-ua="Про мене" data-i18n-en="About" class="text-base uppercase tracking-[0.2em] text-stone-200 py-1">Про мене</a>

        <div class="flex items-center gap-4 pt-3 border-t border-stone-700/50 w-full justify-center mt-1">
          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button class="lang-ua px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-active bg-stone-200 text-stone-900 shadow">UA</button>
            <button class="lang-en px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-inactive text-stone-400 hover:text-white">EN</button>
          </div>

          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button class="theme-toggle px-2.5 py-1 rounded-full text-xs cursor-pointer text-stone-300 hover:text-white flex items-center justify-center" title="Toggle Theme">
              <svg class="theme-icon-moon w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M21.75 15.002A9.718 9.718 0 0112 21.75c-5.385 0-9.75-4.365-9.75-9.75 0-4.137 2.57-7.676 6.22-9.11a.75.75 0 01.916.92 7.502 7.502 0 009.244 9.244.75.75 0 01.92.916z"/>
              </svg>
              <svg class="theme-icon-sun w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
                <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.061-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.166 5.106a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.061-1.06l-1.59-1.591z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-10">
      <div class="text-center mb-12">
        <h1 data-i18n-ua="Галерея робіт" data-i18n-en="Full Portfolio" class="text-4xl md:text-5xl font-light italic mt-2">
          Галерея робіт
        </h1>
      </div>

      <!-- Категорії -->
      <div class="flex flex-wrap justify-center gap-3 md:gap-6 mb-16 text-xs uppercase tracking-widest">
        {categories.map((cat) => (
          <button
            class="filter-btn px-5 py-2 rounded-full border border-stone-600 transition cursor-pointer text-stone-300"
            data-category={cat.id}
            data-i18n-ua={cat.ua}
            data-i18n-en={cat.en}
          >
            {cat.ua}
          </button>
        ))}
      </div>

      <!-- Сітка проєктів -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project: any) => {
          const rawCover = project.coverUrl || project.mainImageUrl || project.galleryUrls?.[0];
          const cover = getHighResUrl(rawCover, 1600);
          return (
            <a
              href={`/projects/${project.slug}`}
              class="project-card site-card group block bg-[#2e2c2a] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition border border-stone-700/60"
              data-category={project.category}
            >
              <div class="h-80 overflow-hidden bg-stone-800 relative">
                {cover ? (
                  <img src={cover} alt={project.titleUa || 'Project'} class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-xs text-stone-500">Немає фото</div>
                )}
              </div>
              <div class="p-6">
                <span class="text-[10px] uppercase tracking-widest text-stone-400 block mb-1">
                  {project.category}
                </span>
                <h2 data-title-ua={project.titleUa} data-title-en={project.titleEn || project.titleUa} class="project-title text-2xl font-light text-stone-200">
                  {project.titleUa}
                </h2>
              </div>
            </a>
          );
        })}
      </div>
    </main>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        mobileMenu?.classList.toggle('flex');
      });

      function toggleTheme() {
        document.body.classList.toggle('light-theme');
        const isLight = document.body.classList.contains('light-theme');
        
        document.querySelectorAll('.theme-icon-moon').forEach(el => {
          if (isLight) el.classList.add('hidden'); else el.classList.remove('hidden');
        });
        document.querySelectorAll('.theme-icon-sun').forEach(el => {
          if (isLight) el.classList.remove('hidden'); else el.classList.add('hidden');
        });

        localStorage.setItem('preferred_theme', isLight ? 'light' : 'dark');
      }

      document.querySelectorAll('.theme-toggle').forEach(btn => {
        btn.addEventListener('click', toggleTheme);
      });

      if (localStorage.getItem('preferred_theme') === 'light') {
        document.body.classList.add('light-theme');
        document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.remove('hidden'));
      }

      function switchLanguage(lang: 'ua' | 'en') {
        document.querySelectorAll('.lang-ua').forEach(btn => {
          if (lang === 'ua') {
            btn.classList.add('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.remove('lang-btn-inactive', 'text-stone-400');
          } else {
            btn.classList.remove('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.add('lang-btn-inactive', 'text-stone-400');
          }
        });

        document.querySelectorAll('.lang-en').forEach(btn => {
          if (lang === 'en') {
            btn.classList.add('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.remove('lang-btn-inactive', 'text-stone-400');
          } else {
            btn.classList.remove('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.add('lang-btn-inactive', 'text-stone-400');
          }
        });

        document.querySelectorAll('[data-i18n-ua]').forEach((el) => {
          const target = el as HTMLElement;
          const text = target.getAttribute(`data-i18n-${lang}`);
          if (text) target.textContent = text;
        });

        document.querySelectorAll('.project-title').forEach((el) => {
          const target = el as HTMLElement;
          const title = target.getAttribute(`data-title-${lang}`);
          if (title) target.textContent = title;
        });

        localStorage.setItem('preferred_lang', lang);
      }

      document.querySelectorAll('.lang-ua').forEach(btn => btn.addEventListener('click', () => switchLanguage('ua')));
      document.querySelectorAll('.lang-en').forEach(btn => btn.addEventListener('click', () => switchLanguage('en')));

      const savedLang = (localStorage.getItem('preferred_lang') as 'ua' | 'en') || 'ua';
      switchLanguage(savedLang);

      // Фільтри
      const filterBtns = document.querySelectorAll('.filter-btn');
      const projectCards = document.querySelectorAll('.project-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category');

          filterBtns.forEach(b => b.classList.remove('bg-stone-200', 'text-stone-900', 'font-bold'));
          btn.classList.add('bg-stone-200', 'text-stone-900', 'font-bold');

          projectCards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (cat === 'all' || cardCat === cat) {
              (card as HTMLElement).style.display = 'block';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      filterBtns[0]?.classList.add('bg-stone-200', 'text-stone-900', 'font-bold');
    </script>
  </body>
</html>