---
import { sanityClient } from 'sanity:client';

const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    "aboutImageUrl": aboutImage.asset->url,
    photographerName,
    photographerNameEn,
    aboutTextUa,
    aboutTextEn,
    instagram, telegram, email, phone
  }
`);

const nameUa = settings?.photographerName || 'Марина Морозюк';
const nameEn = settings?.photographerNameEn || 'Maryna Moroziuk';

function getHighResUrl(url: string | undefined, width = 1600) {
  if (!url) return '';
  const separator = url.includes('?') ? '&' : '?';
  return `${url}${separator}w=${width}&q=90&auto=format`;
}

const aboutImage = getHighResUrl(settings?.aboutImageUrl, 1600);
const aboutUa = settings?.aboutTextUa || "Моя мета — зберігати щирі емоції, естетику моменту та унікальну атмосферу кожної зйомки.";
const aboutEn = settings?.aboutTextEn || "My goal is to capture genuine emotions, aesthetic moments, and the unique atmosphere of every photoshoot.";
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Про автора | Portfolio</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#232220] text-[#f5f2eb] min-h-screen flex flex-col justify-between pt-32 text-lg">

    <!-- ШАПКА -->
    <header class="site-header fixed top-0 left-0 right-0 z-50 pt-6 pb-12">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <a href="/" class="header-logo text-xl tracking-[0.25em] uppercase font-light">
          PHOTOGRAPHER
        </a>

        <nav class="hidden md:flex items-center gap-10 text-sm uppercase tracking-[0.2em] font-light">
          <a href="/gallery" data-i18n-ua="Галерея" data-i18n-en="Gallery" class="site-nav-link text-stone-300 hover:text-white transition">Галерея</a>
          <a href="/price" data-i18n-ua="Прайс" data-i18n-en="Price" class="site-nav-link text-stone-300 hover:text-white transition">Прайс</a>
          <a href="/about" data-i18n-ua="Про мене" data-i18n-en="About" class="site-nav-link active text-white border-b border-white pb-0.5 font-normal">Про мене</a>
        </nav>

        <div class="hidden md:flex items-center gap-3 text-sm font-light tracking-wider">
          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button class="lang-ua px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-active bg-stone-200 text-stone-900 shadow">UA</button>
            <button class="lang-en px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-inactive text-stone-400 hover:text-white">EN</button>
          </div>

          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button id="theme-toggle" class="px-2.5 py-1 rounded-full text-xs cursor-pointer text-stone-300 hover:text-white flex items-center justify-center" title="Toggle Theme">
              <svg id="theme-icon-moon" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M21.75 15.002A9.718 9.718 0 0112 21.75c-5.385 0-9.75-4.365-9.75-9.75 0-4.137 2.57-7.676 6.22-9.11a.75.75 0 01.916.92 7.502 7.502 0 009.244 9.244.75.75 0 01.92.916z"/>
              </svg>
              <svg id="theme-icon-sun" class="w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
                <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.061-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.166 5.106a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.061-1.06l-1.59-1.591z"/>
              </svg>
            </button>
          </div>
        </div>

        <button id="mobile-menu-btn" class="md:hidden text-2xl p-1 focus:outline-none" aria-label="Toggle Menu">☰</button>
      </div>

      <div id="mobile-menu" class="hidden md:hidden bg-[#232220]/95 backdrop-blur-lg px-6 py-6 flex-col gap-4 text-center">
        <a href="/gallery" data-i18n-ua="Галерея" data-i18n-en="Gallery" class="text-base uppercase tracking-[0.2em] text-stone-200 py-1">Галерея</a>
        <a href="/price" data-i18n-ua="Прайс" data-i18n-en="Price" class="text-base uppercase tracking-[0.2em] text-stone-200 py-1">Прайс</a>
        <a href="/about" data-i18n-ua="Про мене" data-i18n-en="About" class="text-base uppercase tracking-[0.2em] text-white font-bold py-1">Про мене</a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-12 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">
        {aboutImage && (
          <div class="flex justify-center">
            <img src={aboutImage} alt={nameUa} class="w-80 sm:w-96 h-[480px] sm:h-[520px] object-cover rounded-2xl shadow-2xl border-4 border-stone-800" />
          </div>
        )}

        <div>
          <!-- ТЕХНІЧНИЙ НАПИС ABOUT AUTHOR ВИДАЛЕНО -->
          
          <h1 data-i18n-ua={nameUa} data-i18n-en={nameEn} class="text-5xl sm:text-6xl font-light italic mb-6 text-stone-100">
            {nameUa}
          </h1>
          
          <p data-i18n-ua={aboutUa} data-i18n-en={aboutEn} class="text-lg sm:text-xl leading-relaxed text-stone-300 font-light mb-10">
            {aboutUa}
          </p>

          <!-- Контакти -->
          <div class="border-t border-stone-700/60 pt-8 grid grid-cols-2 gap-6">
            {settings?.instagram && (
              <div>
                <span class="text-xs uppercase tracking-widest text-stone-400 block mb-1">Instagram</span>
                <a href={settings.instagram.startsWith('http') ? settings.instagram : `https://instagram.com/${settings.instagram.replace('@', '')}`} target="_blank" class="text-sm font-light text-stone-200 hover:underline">
                  {settings.instagram}
                </a>
              </div>
            )}

            {settings?.telegram && (
              <div>
                <span class="text-xs uppercase tracking-widest text-stone-400 block mb-1">Telegram</span>
                <a href={settings.telegram.startsWith('http') ? settings.telegram : `https://t.me/${settings.telegram.replace('@', '')}`} target="_blank" class="text-sm font-light text-stone-200 hover:underline">
                  {settings.telegram}
                </a>
              </div>
            )}

            {settings?.email && (
              <div>
                <span class="text-xs uppercase tracking-widest text-stone-400 block mb-1">Email</span>
                <a href={`mailto:${settings.email}`} class="text-sm font-light text-stone-200 hover:underline">
                  {settings.email}
                </a>
              </div>
            )}

            {settings?.phone && (
              <div>
                <span class="text-xs uppercase tracking-widest text-stone-400 block mb-1" data-i18n-ua="Телефон" data-i18n-en="Phone">Телефон</span>
                <a href={`tel:${settings.phone}`} class="text-sm font-light text-stone-200 hover:underline">
                  {settings.phone}
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    </main>

    <footer class="p-6 text-center text-xs text-stone-400 tracking-widest uppercase">
      © {new Date().getFullYear()} <span data-i18n-ua={nameUa} data-i18n-en={nameEn}>{nameUa}</span>. All rights reserved.
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        mobileMenu?.classList.toggle('flex');
      });

      const themeToggle = document.getElementById('theme-toggle');
      const themeIconMoon = document.getElementById('theme-icon-moon');
      const themeIconSun = document.getElementById('theme-icon-sun');

      function toggleTheme() {
        document.body.classList.toggle('light-theme');
        const isLight = document.body.classList.contains('light-theme');
        if (isLight) {
          themeIconMoon?.classList.add('hidden');
          themeIconSun?.classList.remove('hidden');
        } else {
          themeIconMoon?.classList.remove('hidden');
          themeIconSun?.classList.add('hidden');
        }
        localStorage.setItem('preferred_theme', isLight ? 'light' : 'dark');
      }

      themeToggle?.addEventListener('click', toggleTheme);

      if (localStorage.getItem('preferred_theme') === 'light') {
        document.body.classList.add('light-theme');
        themeIconMoon?.classList.add('hidden');
        themeIconSun?.classList.remove('hidden');
      }

      function switchLanguage(lang: 'ua' | 'en') {
        document.querySelectorAll('.lang-ua').forEach(btn => {
          if (lang === 'ua') {
            btn.classList.add('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.remove('lang-btn-inactive', 'text-stone-400');
          } else {
            btn.classList.remove('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.add('lang-btn-inactive', 'text-stone-400');
          }
        });

        document.querySelectorAll('.lang-en').forEach(btn => {
          if (lang === 'en') {
            btn.classList.add('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.remove('lang-btn-inactive', 'text-stone-400');
          } else {
            btn.classList.remove('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.add('lang-btn-inactive', 'text-stone-400');
          }
        });

        document.querySelectorAll('[data-i18n-ua]').forEach((el) => {
          const target = el as HTMLElement;
          const text = target.getAttribute(`data-i18n-${lang}`);
          if (text) target.textContent = text;
        });

        localStorage.setItem('preferred_lang', lang);
      }

      document.querySelectorAll('.lang-ua').forEach(btn => btn.addEventListener('click', () => switchLanguage('ua')));
      document.querySelectorAll('.lang-en').forEach(btn => btn.addEventListener('click', () => switchLanguage('en')));

      const savedLang = (localStorage.getItem('preferred_lang') as 'ua' | 'en') || 'ua';
      switchLanguage(savedLang);
    </script>
  </body>
</html>