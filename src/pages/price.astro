---
import { sanityClient } from 'sanity:client';

const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    instagram, telegram, email, phone
  }
`);
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Прайс та Послуги | Portfolio</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#232220] text-[#f5f2eb] min-h-screen pt-32 font-serif text-lg">

    <!-- ШАПКА З ОМБРЕ-ШИРМОЮ -->
    <header class="site-header fixed top-0 left-0 right-0 z-50 pt-6 pb-12">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <a href="/" class="text-xl tracking-[0.25em] uppercase font-light">
          PHOTOGRAPHER
        </a>

        <nav class="hidden md:flex items-center gap-10 text-sm uppercase tracking-[0.2em] font-light">
          <a href="/gallery" data-i18n-ua="Галерея" data-i18n-en="Gallery" class="site-nav-link text-stone-300 hover:text-white transition">Галерея</a>
          <a href="/price" data-i18n-ua="Прайс" data-i18n-en="Price" class="site-nav-link active text-white border-b border-white pb-0.5 font-normal">Прайс</a>
          <a href="/about" data-i18n-ua="Про мене" data-i18n-en="About" class="site-nav-link text-stone-300 hover:text-white transition">Про мене</a>
        </nav>

        <div class="hidden md:flex items-center gap-3 text-sm font-light tracking-wider">
          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button class="lang-ua px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-active bg-stone-200 text-stone-900 shadow">UA</button>
            <button class="lang-en px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all duration-300 lang-btn-inactive text-stone-400 hover:text-white">EN</button>
          </div>

          <div class="pill-container flex items-center p-0.5 rounded-full border border-stone-600/50 bg-black/20">
            <button id="theme-toggle" class="px-2.5 py-1 rounded-full text-xs transition cursor-pointer text-stone-300 hover:text-white flex items-center justify-center" title="Toggle Theme">
              <svg id="theme-icon-moon" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M21.75 15.002A9.718 9.718 0 0112 21.75c-5.385 0-9.75-4.365-9.75-9.75 0-4.137 2.57-7.676 6.22-9.11a.75.75 0 01.916.92 7.502 7.502 0 009.244 9.244.75.75 0 01.92.916z"/>
              </svg>
              <svg id="theme-icon-sun" class="w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
                <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.061-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.166 5.106a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.061-1.06l-1.59-1.591z"/>
              </svg>
            </button>
          </div>
        </div>

        <button id="mobile-menu-btn" class="md:hidden text-2xl p-1 focus:outline-none" aria-label="Toggle Menu">☰</button>
      </div>

      <div id="mobile-menu" class="hidden md:hidden bg-[#232220]/95 backdrop-blur-lg px-6 py-6 flex-col gap-4 text-center">
        <a href="/gallery" data-i18n-ua="Галерея" data-i18n-en="Gallery" class="text-base uppercase tracking-[0.2em] text-stone-200 py-1">Галерея</a>
        <a href="/price" data-i18n-ua="Прайс" data-i18n-en="Price" class="text-base uppercase tracking-[0.2em] text-white font-bold py-1">Прайс</a>
        <a href="/about" data-i18n-ua="Про мене" data-i18n-en="About" class="text-base uppercase tracking-[0.2em] text-stone-200 py-1">Про мене</a>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12">
      <div class="text-center mb-14 fade-in-element">
        <h1 data-i18n-ua="Прайс та Послуги" data-i18n-en="Services & Prices" class="text-4xl sm:text-5xl md:text-6xl italic font-light">
          Прайс та Послуги
        </h1>
      </div>

      <!-- Картки тарифів -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        
        <!-- ПАКЕТ 1: Портретна -->
        <div class="site-card bg-[#2e2c2a] p-8 sm:p-9 rounded-2xl border border-stone-700/60 shadow-xl flex flex-col justify-between transition fade-in-element">
          <div>
            <h2 data-i18n-ua="Портретна зйомка" data-i18n-en="Portrait Session" class="text-2xl sm:text-3xl italic font-light mb-4 text-white">
              Портретна зйомка
            </h2>

            <div class="mb-5 flex gap-2">
              <button class="time-opt active px-3.5 py-1 rounded-full border border-stone-500 text-xs uppercase tracking-wider cursor-pointer transition bg-stone-200 text-stone-900 font-bold" 
                data-hours="1" 
                data-price-ua="2 500 ₴" 
                data-price-en="$65" 
                data-photos-ua="30+ фото в авторській обробці" 
                data-photos-en="30+ edited photos"
                data-days-ua="7 робочих днів"
                data-days-en="7 business days"
              >
                1 <span data-i18n-ua="година" data-i18n-en="hour">година</span>
              </button>

              <button class="time-opt px-3.5 py-1 rounded-full border border-stone-600/60 text-xs uppercase tracking-wider cursor-pointer transition hover:border-stone-400 text-stone-300" 
                data-hours="2" 
                data-price-ua="4 500 ₴" 
                data-price-en="$115" 
                data-photos-ua="60+ фото в авторській обробці" 
                data-photos-en="60+ edited photos"
                data-days-ua="10 робочих днів"
                data-days-en="10 business days"
              >
                2 <span data-i18n-ua="години" data-i18n-en="hours">години</span>
              </button>
            </div>
            
            <p class="card-price text-2xl font-light mb-6 text-stone-100 transition-all duration-300">
              2 500 ₴ <span class="card-time-label text-sm text-stone-400">/ 1 <span data-i18n-ua="година" data-i18n-en="hour">година</span></span>
            </p>

            <ul class="text-sm sm:text-base text-stone-300 space-y-3.5 font-light border-t border-stone-700/60 pt-6">
              <li data-i18n-ua="• Консультація та підбір образу/локації" data-i18n-en="• Concept, location & style consultation">• Консультація та підбір образу/локації</li>
              <li class="card-photos" data-i18n-ua="• 30+ фото в авторській обробці" data-i18n-en="• 30+ edited photos">• 30+ фото в авторській обробці</li>
              <li data-i18n-ua="• Усі вдалі вихідники (за запитом)" data-i18n-en="• All good RAW files (upon request)">• Усі вдалі вихідники (за запитом)</li>
              <li data-i18n-ua="• Студійна або виїзна зйомка" data-i18n-en="• Studio or outdoor session">• Студійна або виїзна зйомка</li>
              <li class="card-delivery" data-i18n-ua="• Готовність матеріалу до 7 робочих днів" data-i18n-en="• Delivery within 7 business days">• Готовність матеріалу до 7 робочих днів</li>
            </ul>
          </div>
          <a href="/about" data-i18n-ua="Забронювати" data-i18n-en="Book Now" class="mt-10 text-center block w-full py-3.5 border border-stone-500 text-stone-200 hover:bg-[#f5f2eb] hover:text-[#232220] transition text-xs sm:text-sm uppercase tracking-[0.2em] rounded-full">
            Забронювати
          </a>
        </div>

        <!-- ПАКЕТ 2: Content / Fashion -->
        <div class="site-card site-card-popular bg-[#383532] p-8 sm:p-9 rounded-2xl border border-stone-500 shadow-2xl flex flex-col justify-between relative fade-in-element">
          <span data-i18n-ua="Популярний" data-i18n-en="Popular" class="popular-badge absolute -top-3.5 right-6 bg-[#f5f2eb] text-[#232220] text-[10px] sm:text-xs uppercase tracking-[0.2em] px-4 py-1 rounded-full font-semibold">
            Популярний
          </span>
          <div>
            <h2 data-i18n-ua="Content / Fashion" data-i18n-en="Content / Fashion" class="text-2xl sm:text-3xl italic font-light mb-4 text-white">
              Content / Fashion
            </h2>

            <div class="mb-5 flex gap-2">
              <button class="time-opt px-3.5 py-1 rounded-full border border-stone-600/60 text-xs uppercase tracking-wider cursor-pointer transition hover:border-stone-400 text-stone-300" 
                data-hours="1" 
                data-price-ua="2 800 ₴" 
                data-price-en="$75" 
                data-photos-ua="35+ фото в авторській ретуші" 
                data-photos-en="35+ retouched photos"
                data-days-ua="7 робочих днів"
                data-days-en="7 business days"
              >
                1 <span data-i18n-ua="година" data-i18n-en="hour">година</span>
              </button>

              <button class="time-opt active px-3.5 py-1 rounded-full border border-stone-500 text-xs uppercase tracking-wider cursor-pointer transition bg-stone-200 text-stone-900 font-bold" 
                data-hours="2" 
                data-price-ua="4 800 ₴" 
                data-price-en="$125" 
                data-photos-ua="70+ фото в авторській ретуші" 
                data-photos-en="70+ retouched photos"
                data-days-ua="10 робочих днів"
                data-days-en="10 business days"
              >
                2 <span data-i18n-ua="години" data-i18n-en="hours">години</span>
              </button>
            </div>

            <p class="card-price text-2xl font-light mb-6 text-stone-100 transition-all duration-300">
              4 800 ₴ <span class="card-time-label text-sm text-stone-300">/ 2 <span data-i18n-ua="години" data-i18n-en="hours">години</span></span>
            </p>

            <ul class="text-sm sm:text-base text-stone-200 space-y-3.5 font-light border-t border-stone-500/80 pt-6">
              <li data-i18n-ua="• Консультація та підбір стилістики зйомки" data-i18n-en="• Styling & location consultation">• Консультація та підбір стилістики зйомки</li>
              <li class="card-photos" data-i18n-ua="• 70+ фото в авторській ретуші" data-i18n-en="• 70+ retouched photos">• 70+ фото в авторській ретуші</li>
              <li data-i18n-ua="• Зйомка для брендів або персонального блогу" data-i18n-en="• Content for personal brand or business">• Зйомка для брендів або персонального блогу</li>
              <li data-i18n-ua="• Усі вдалі вихідники (за запитом)" data-i18n-en="• All good RAW files (upon request)">• Усі вдалі вихідники (за запитом)</li>
              <li class="card-delivery" data-i18n-ua="• Готовність матеріалу до 10 робочих днів" data-i18n-en="• Delivery within 10 business days">• Готовність матеріалу до 10 робочих днів</li>
            </ul>
          </div>
          <a href="/about" data-i18n-ua="Забронювати" data-i18n-en="Book Now" class="btn-primary mt-10 text-center block w-full py-3.5 bg-[#f5f2eb] text-[#232220] hover:bg-white transition text-xs sm:text-sm uppercase tracking-[0.2em] rounded-full shadow font-medium">
            Забронювати
          </a>
        </div>

        <!-- ПАКЕТ 3: Love Story / Парна -->
        <div class="site-card bg-[#2e2c2a] p-8 sm:p-9 rounded-2xl border border-stone-700/60 shadow-xl flex flex-col justify-between transition fade-in-element">
          <div>
            <h2 data-i18n-ua="Love Story / Парна" data-i18n-en="Love Story / Couple" class="text-2xl sm:text-3xl italic font-light mb-4 text-white">
              Love Story / Парна
            </h2>

            <div class="mb-5 flex gap-2">
              <button class="time-opt px-3.5 py-1 rounded-full border border-stone-600/60 text-xs uppercase tracking-wider cursor-pointer transition hover:border-stone-400 text-stone-300" 
                data-hours="1" 
                data-price-ua="2 800 ₴" 
                data-price-en="$75" 
                data-photos-ua="30+ опрацьованих фотографій" 
                data-photos-en="30+ edited photos"
                data-days-ua="7 робочих днів"
                data-days-en="7 business days"
              >
                1 <span data-i18n-ua="година" data-i18n-en="hour">година</span>
              </button>

              <button class="time-opt active px-3.5 py-1 rounded-full border border-stone-500 text-xs uppercase tracking-wider cursor-pointer transition bg-stone-200 text-stone-900 font-bold" 
                data-hours="1.5" 
                data-price-ua="3 800 ₴" 
                data-price-en="$100" 
                data-photos-ua="50+ опрацьованих фотографій" 
                data-photos-en="50+ edited photos"
                data-days-ua="10 робочих днів"
                data-days-en="10 business days"
              >
                1.5 <span data-i18n-ua="години" data-i18n-en="hours">години</span>
              </button>
            </div>

            <p class="card-price text-2xl font-light mb-6 text-stone-100 transition-all duration-300">
              3 800 ₴ <span class="card-time-label text-sm text-stone-400">/ 1.5 <span data-i18n-ua="години" data-i18n-en="hours">години</span></span>
            </p>

            <ul class="text-sm sm:text-base text-stone-300 space-y-3.5 font-light border-t border-stone-700/60 pt-6">
              <li data-i18n-ua="• Жива репортажна та постановочна зйомка" data-i18n-en="• Lifestyle & candid couple storytelling">• Жива репортажна та постановочна зйомка</li>
              <li class="card-photos" data-i18n-ua="• 50+ опрацьованих фотографій" data-i18n-en="• 50+ edited photos">• 50+ опрацьованих фотографій</li>
              <li data-i18n-ua="• Персональна онлайн-галерея" data-i18n-en="• Private online web gallery">• Персональна онлайн-галерея</li>
              <li data-i18n-ua="• Допомога з позивуванням та атмосферними локаціями" data-i18n-en="• Posing guidance & romantic locations">• Допомога з позивуванням та атмосферними локаціями</li>
              <li class="card-delivery" data-i18n-ua="• Готовність матеріалу до 10 робочих днів" data-i18n-en="• Delivery within 10 business days">• Готовність матеріалу до 10 робочих днів</li>
            </ul>
          </div>
          <a href="/about" data-i18n-ua="Забронювати" data-i18n-en="Book Now" class="mt-10 text-center block w-full py-3.5 border border-stone-500 text-stone-200 hover:bg-[#f5f2eb] hover:text-[#232220] transition text-xs sm:text-sm uppercase tracking-[0.2em] rounded-full">
            Забронювати
          </a>
        </div>
      </div>

      <!-- ЗНОСКИ -->
      <div class="border-t border-stone-700/60 pt-8 text-xs sm:text-sm text-stone-400 font-light space-y-2 fade-in-element">
        <p data-i18n-ua="* Оренда фотостудії, послуги візажиста та стиліста сплачуються окремо." data-i18n-en="* Studio rental, makeup artist and stylist fees are paid separately.">
          * Оренда фотостудії, послуги візажиста та стиліста сплачуються окремо.
        </p>
        <p data-i18n-ua="* Можливі виїзні зйомки в інші міста та локації (транспортні витрати обговорюються індивідуально)." data-i18n-en="* Travel sessions available (transport costs discussed individually).">
          * Можливі виїзні зйомки в інші міста та локації (транспортні витрати обговорюються індивідуально).
        </p>
        <p data-i18n-ua="* Бронювання дати здійснюється за передоплатою." data-i18n-en="* Date booking is confirmed upon deposit payment.">
          * Бронювання дати здійснюється за передоплатою.
        </p>
      </div>
    </main>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        mobileMenu?.classList.toggle('flex');
      });

      const themeToggle = document.getElementById('theme-toggle');
      const themeIconMoon = document.getElementById('theme-icon-moon');
      const themeIconSun = document.getElementById('theme-icon-sun');

      function toggleTheme() {
        document.body.classList.toggle('light-theme');
        const isLight = document.body.classList.contains('light-theme');
        if (isLight) {
          themeIconMoon?.classList.add('hidden');
          themeIconSun?.classList.remove('hidden');
        } else {
          themeIconMoon?.classList.remove('hidden');
          themeIconSun?.classList.add('hidden');
        }
        localStorage.setItem('preferred_theme', isLight ? 'light' : 'dark');
      }

      themeToggle?.addEventListener('click', toggleTheme);

      if (localStorage.getItem('preferred_theme') === 'light') {
        document.body.classList.add('light-theme');
        themeIconMoon?.classList.add('hidden');
        themeIconSun?.classList.remove('hidden');
      }

      function switchLanguage(lang: 'ua' | 'en') {
        document.querySelectorAll('.lang-ua').forEach(btn => {
          if (lang === 'ua') {
            btn.classList.add('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.remove('lang-btn-inactive', 'text-stone-400');
          } else {
            btn.classList.remove('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.add('lang-btn-inactive', 'text-stone-400');
          }
        });

        document.querySelectorAll('.lang-en').forEach(btn => {
          if (lang === 'en') {
            btn.classList.add('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.remove('lang-btn-inactive', 'text-stone-400');
          } else {
            btn.classList.remove('lang-btn-active', 'bg-stone-200', 'text-stone-900', 'shadow');
            btn.classList.add('lang-btn-inactive', 'text-stone-400');
          }
        });

        document.querySelectorAll('[data-i18n-ua]').forEach((el) => {
          const target = el as HTMLElement;
          const text = target.getAttribute(`data-i18n-${lang}`);
          if (text) target.textContent = text;
        });

        updateCardPrices(lang);
        localStorage.setItem('preferred_lang', lang);
      }

      function updateCardPrices(lang: 'ua' | 'en') {
        document.querySelectorAll('.site-card').forEach(card => {
          const activeOpt = card.querySelector('.time-opt.active') as HTMLElement;
          if (!activeOpt) return;

          const price = activeOpt.getAttribute(`data-price-${lang}`);
          const hours = activeOpt.getAttribute('data-hours');
          const photos = activeOpt.getAttribute(`data-photos-${lang}`);
          const days = activeOpt.getAttribute(`data-days-${lang}`);

          const priceEl = card.querySelector('.card-price');
          const photosEl = card.querySelector('.card-photos');
          const deliveryEl = card.querySelector('.card-delivery');

          const hourLabel = lang === 'ua' ? (hours === '1' ? 'година' : 'години') : (hours === '1' ? 'hour' : 'hours');
          const prefix = lang === 'ua' ? '• Готовність матеріалу до ' : '• Delivery within ';

          if (priceEl) {
            priceEl.innerHTML = `${price} <span class="card-time-label text-sm text-stone-400">/ ${hours} ${hourLabel}</span>`;
          }
          if (photosEl) {
            photosEl.textContent = `• ${photos}`;
          }
          if (deliveryEl && days) {
            deliveryEl.textContent = `${prefix}${days}`;
          }
        });
      }

      document.querySelectorAll('.site-card').forEach(card => {
        const timeOpts = card.querySelectorAll('.time-opt');
        
        timeOpts.forEach(btn => {
          btn.addEventListener('click', () => {
            timeOpts.forEach(b => {
              b.classList.remove('active', 'bg-stone-200', 'text-stone-900', 'font-bold');
              b.classList.add('text-stone-300');
            });

            btn.classList.add('active', 'bg-stone-200', 'text-stone-900', 'font-bold');
            btn.classList.remove('text-stone-300');

            const currentLang = (localStorage.getItem('preferred_lang') as 'ua' | 'en') || 'ua';
            updateCardPrices(currentLang);
          });
        });
      });

      document.querySelectorAll('.lang-ua').forEach(btn => btn.addEventListener('click', () => switchLanguage('ua')));
      document.querySelectorAll('.lang-en').forEach(btn => btn.addEventListener('click', () => switchLanguage('en')));

      const savedLang = (localStorage.getItem('preferred_lang') as 'ua' | 'en') || 'ua';
      switchLanguage(savedLang);

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.fade-in-element').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>